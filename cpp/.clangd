CompileFlags:
  # compile_commands.json is generated by build.ps1 and copied to this
  # directory. Regenerate after source changes, then restart clangd:
  #   .\cpp\build.ps1
  #   Ctrl+Shift+P -> "clangd: Restart language server"

  Remove:
    # Flags emitted by cl.exe that clang-cl does not accept.
    - /external:*   # MSVC external-include dirs; no clang equivalent
    - /Fd*          # PDB path; cl.exe only
    - /FS           # Serialize PDB writes; cl.exe only
    - /RTC*         # Runtime checks; MSVC form rejected by clang-cl
    - /Zc:lambda    # Lambda conformance; not needed by clangd
