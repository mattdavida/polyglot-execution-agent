# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
# Chat only — no embedding model needed (no vector store in this project).
# Copy key + endpoint from: az deployment group show --resource-group rg-exa-dev --query properties.outputs
# Copy key + endpoint from your Azure OpenAI resource.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                  # e.g. https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=           # e.g. gpt-4o

# ─── LangGraph Checkpointer ───────────────────────────────────────────────────
# SQLite — no Azure resource required. A local file is created automatically
# on first run. Swap to a Postgres connection string for production deploy.
CHECKPOINTS_DB=./checkpoints.db

# ─── App config ───────────────────────────────────────────────────────────────
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated list for CORS
